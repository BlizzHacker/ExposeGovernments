# {{domain}} state hub - generated by shared/deploy/provision.py
#
# The apex of a state domain is its own site: the map, every chapter in the
# state, the expansion queue, and the statute any resident of that state can use
# whether or not their town has a chapter. It gets its own vhost so it does not
# depend on whichever city chapter happens to sort first.
server {
    listen 80;
    server_name {{hosts_nginx}};

    root {{root}};
    index index.html;

    access_log /var/log/nginx/{{name}}.access.log;
    error_log  /var/log/nginx/{{name}}.error.log;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico|woff2)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location / { try_files $uri $uri/ $uri.html =404; }

    location ~ /\. { deny all; }
}
