# {{site_name}} — {{city}}, {{state_abbr}}
# Generated by shared/deploy/provision.py from chapters/{{key}}.json. Do not edit
# in the container; the next provision run overwrites it.
#
# One vhost per city, all cities of a state in that state's container. TLS is
# terminated at Traefik (LXC 107) and never here.
server {
    listen 80;
    server_name {{hosts_nginx}};

    root {{infra.web_root}};
    index index.html;

    access_log /var/log/nginx/expose{{key}}.access.log;
    error_log  /var/log/nginx/expose{{key}}.error.log;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    gzip on;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # Two files under /data/ are public and the rest of the directory is not.
    # The exact-match locations beat the prefix block regardless of order, but the
    # prefix block MUST stay or a chapter serves its working directory.
    location = /data/site-search-index.json { expires 1h;  add_header Cache-Control "public"; }
    # The automation dashboard is deliberately public: a site that hides its own
    # staleness looks identical to one that is current.
    location = /data/automation.json        { expires 5m;  add_header Cache-Control "public"; }
    location = /data/link-check.json        { expires 5m;  add_header Cache-Control "public"; }
    # The meeting index as data. Publishing it means a reporter or another
    # nonprofit can use this archive without scraping the HTML we built off the
    # city's portal in the first place - which is the whole point of collecting
    # it. CORS is open because a JSON feed nobody may fetch is not published.
    location = /data/meetings.json {
        expires 1h;
        add_header Cache-Control "public";
        add_header Access-Control-Allow-Origin "*";
    }
    location /data/ { return 404; }

    # Agenda and packet PDFs pulled from the city's own portal. They are public
    # records and never change once published, so they cache hard.
    location /meetings/files/ { expires 30d; add_header Cache-Control "public"; }
    location /documents/files/ { expires 30d; add_header Cache-Control "public"; }

    location = /records { return 301 /records/; }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico|woff2)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location = /robots.txt  { access_log off; }
    location = /favicon.svg { access_log off; expires 30d; }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    location ~ /\. { deny all; }
}
