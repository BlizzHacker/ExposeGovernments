  "statute": {
    "name": "Texas Public Information Act",
    "citation": "Tex. Gov't Code ch. 552",
    "response_section": "§ 552.301",
    "response_window": "ten (10) business days",
    "fee_section": "§ 552.2615",
    "fee_threshold": "$40.00",
    "residency_required": false,
    "appeal": {
      "body": "Texas Attorney General",
      "citation": "§ 552.301",
      "free": false,
      "powers": "rules on whether the body may withhold, on the body's own request",
      "sentence": "Texas has no free citizen appeal board. If the City wants to withhold, <em>it</em> must ask the Attorney General for a ruling within ten business days (&sect; 552.301) and send you a copy of what it asked &mdash; that request and the ruling are both public, and they are the best record of what a city tried to hide. If the City simply never answers, a complaint goes to the county or district attorney under &sect; 552.3215, or you can sue for mandamus under &sect; 552.321."
    }
  },
