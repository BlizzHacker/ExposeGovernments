  "statute": {
    "name": "Oklahoma Open Records Act",
    "citation": "51 O.S. § 24A.1 et seq.",
    "response_section": "§ 24A.5",
    "response_window": "prompt, reasonable time",
    "fee_section": "§ 24A.5(3)",
    "fee_threshold": "$25.00",
    "residency_required": false,
    "appeal": {
      "body": "district court",
      "citation": "51 O.S. § 24A.17",
      "free": false,
      "powers": "civil action; a prevailing requester can recover attorney fees",
      "sentence": "Oklahoma has no administrative appeal and no fixed deadline &mdash; only a &ldquo;prompt, reasonable&rdquo; standard, which makes delay the default tactic. Enforcement is a civil action in district court under 51 O.S. &sect; 24A.17, and a requester who prevails can recover attorney fees, which is what makes the remedy usable at all. Because the deadline is a standard rather than a number, a dated written record of every follow-up is the case."
    }
  },
