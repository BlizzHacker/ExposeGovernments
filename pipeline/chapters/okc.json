  "issue": {
    "headline": "Where the MAPS money actually lands",
    "body": "Oklahoma City's MAPS programme is a voter-approved sales tax that has moved well over a billion dollars through successive rounds, and the state capital runs the largest economic-development incentive book in Oklahoma. The structural question is not whether the projects happened — it is which contracts, change orders and incentive agreements carry the spend, and those are records the City holds.",
    "record": "MAPS contract and change-order files, and the economic-development agreements approved by resolution, requested by date range from the City Clerk."
  },
  "oversight": [
    {
      "label": "Oklahoma Attorney General",
      "url": "https://oklahoma.gov/oag.html",
      "note": "Issues Open Records Act opinions. Oklahoma has no free citizen appeal forum — enforcement is a district-court action under § 24A.17."
    },
    {
      "label": "Oklahoma State Auditor & Inspector",
      "url": "https://www.sai.ok.gov/",
      "note": "Audits every county and, on petition or request, municipalities. Published audits are public records."
