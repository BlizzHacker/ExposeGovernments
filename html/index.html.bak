// Theme toggle
const themeToggle = document.getElementById('theme-toggle');
const themeIcon = document.getElementById('theme-icon');
const themeText = document.getElementById('theme-text');

themeToggle.addEventListener('click', () => {
  const currentTheme = document.documentElement.getAttribute('data-theme');
  const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', newTheme);
  localStorage.setItem('theme', newTheme);
  updateThemeUI(newTheme);
});

function updateThemeUI(theme) {
  if (theme === 'dark') {
    themeIcon.textContent = '☀️';
    themeText.textContent = 'Light Mode';
  } else {
    themeIcon.textContent = '🌙';
    themeText.textContent = 'Dark Mode';
  }
}

// Load saved theme
const savedTheme = localStorage.getItem('theme') || 'light';
document.documentElement.setAttribute('data-theme', savedTheme);
updateThemeUI(savedTheme);

// Language switcher
const langSelect = document.getElementById('lang-select');
langSelect.addEventListener('change', (e) => {
  const lang = e.target.value;
  localStorage.setItem('lang', lang);
  applyTranslations(lang);
});

function applyTranslations(lang) {
  const trans = translations[lang];
  if (!trans) return;
  
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (trans[key]) {
      el.innerHTML = trans[key];
    }
  });
}

// Load saved language
const savedLang = localStorage.getItem('lang') || 'en';
langSelect.value = savedLang;
applyTranslations(savedLang);

// Load YouTube RSS feed
async function loadFeed() {
  const YT_NS = 'http://www.youtube.com/xml/schemas/2015';
  const MEDIA_NS = 'http://search.yahoo.com/mrss/';
  const ATOM_NS = 'http://www.w3.org/2005/Atom';
  
  try {
    const response = await fetch('/api/youtube-feed');
    const xmlText = await response.text();
    
    const parser = new DOMParser();
    const xml = parser.parseFromString(xmlText, 'text/xml');

    
    // Check for parse errors
    const parseError = xml.querySelector('parsererror');
    if (parseError) {
      throw new Error('XML parse error');
    }
    
    const entries = xml.getElementsByTagNameNS(ATOM_NS, 'entry');
    
    // Filter for Miami/Oklahoma related content
    const keywords = ['miami', 'oklahoma', 'mayor', 'parker', 'bless', 'durbin', 'ottawa', 'county', 'council', 'corruption', 'guerrilla', 'ron durbin'];
    const filteredEntries = Array.from(entries).filter(entry => {
      const titleEl = entry.getElementsByTagNameNS(ATOM_NS, 'title')[0];
      const title = titleEl ? titleEl.textContent.toLowerCase() : '';
      const descEl = entry.getElementsByTagNameNS(MEDIA_NS, 'description')[0];
      const desc = descEl ? descEl.textContent.toLowerCase() : '';
      const groupEl = entry.getElementsByTagNameNS(MEDIA_NS, 'group')[0];
      const groupTitle = groupEl ? (groupEl.getElementsByTagNameNS(MEDIA_NS, 'title')[0]?.textContent.toLowerCase() || '') : '';
      return keywords.some(kw => title.includes(kw) || desc.includes(kw) || groupTitle.includes(kw));
    });
    
    const feedContainer = document.getElementById('feed-content');
    
    if (filteredEntries.length === 0) {
      feedContainer.innerHTML = '<p style="text-align: center; color: var(--text-secondary); padding: 40px;">No recent Miami/Oklahoma-related content found in the public feed. Showing all recent videos below.</p>';
      // Show all entries as fallback
      showEntries(Array.from(entries).slice(0, 8), feedContainer, true);
      return;
    }
    
    showEntries(filteredEntries.slice(0, 10), feedContainer, false);
    
  } catch (error) {
    console.error('Feed load error:', error.message, error.stack);
    document.getElementById('feed-content').innerHTML = '<p style="text-align: center; color: var(--warning); padding: 40px;">Unable to load feed. Please try again later.</p>';
  }
}

function showEntries(entries, container, append) {
  const YT_NS = 'http://www.youtube.com/xml/schemas/2015';
  const MEDIA_NS = 'http://search.yahoo.com/mrss/';
  const ATOM_NS = 'http://www.w3.org/2005/Atom';
  
  const feedHTML = entries.map(entry => {
    const titleEl = entry.getElementsByTagNameNS(ATOM_NS, 'title')[0];
    const title = titleEl ? titleEl.textContent : 'Untitled';
    
    const videoIdEl = entry.getElementsByTagNameNS(YT_NS, 'videoId')[0];
    const videoId = videoIdEl ? videoIdEl.textContent : '';
    
    const publishedEl = entry.getElementsByTagNameNS(ATOM_NS, 'published')[0];
    const published = publishedEl ? publishedEl.textContent : '';
    
    const linkEl = entry.getElementsByTagNameNS(ATOM_NS, 'link')[0];
    const link = linkEl ? linkEl.getAttribute('href') : (videoId ? `https://www.youtube.com/watch?v=${videoId}` : '#');
    
    const thumbnailEl = entry.getElementsByTagNameNS(MEDIA_NS, 'thumbnail')[0];
    const thumbnail = thumbnailEl ? thumbnailEl.getAttribute('url') : (videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : '');
    
    const descEl = entry.getElementsByTagNameNS(MEDIA_NS, 'description')[0];
    const description = descEl ? descEl.textContent : '';
    
    const date = published ? new Date(published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
    
    return `
      <div class="feed-item">
        ${thumbnail ? `<a href="${link}" target="_blank" rel="noopener"><img src="${thumbnail}" alt="${title}" loading="lazy"></a>` : ''}
        <div class="feed-item-content">
          <h4><a href="${link}" target="_blank" rel="noopener">${title}</a></h4>
          <div class="meta">📅 ${date} • <a href="${link}" target="_blank" rel="noopener">Watch on YouTube</a></div>
          <p>${description.substring(0, 250)}${description.length > 250 ? '...' : ''}</p>
        </div>
      </div>
    `;
  }).join('');
  
  if (append) {
    container.innerHTML += feedHTML;
  } else {
    container.innerHTML = feedHTML;
  }
  document.getElementById('feed-updated').textContent = new Date().toLocaleString();
}

// Load feed on page load
loadFeed();

// Refresh feed every 5 minutes
setInterval(loadFeed, 5 * 60 * 1000);
</script>

</body>
</html>
