<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ExposeMiamiOK - Community Resources & Public Information</title>
<meta name="description" content="Community resources, public information, and government transparency portal for Miami, Oklahoma. A project of the MoveWeight Foundation.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Merriweather:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg-primary: #ffffff;
  --bg-secondary: #f5f7fa;
  --bg-card: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #4a5568;
  --border: #e2e8f0;
  --accent: #2563eb;
  --accent-hover: #1d4ed8;
  --warning: #dc2626;
  --success: #059669;
  --shadow: rgba(0,0,0,0.08);
  --shadow-lg: rgba(0,0,0,0.12);
}

[data-theme="dark"] {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-card: #1e293b;
  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --border: #334155;
  --accent: #3b82f6;
  --accent-hover: #60a5fa;
  --warning: #ef4444;
  --success: #10b981;
  --shadow: rgba(0,0,0,0.3);
  --shadow-lg: rgba(0,0,0,0.5);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  transition: background 0.3s, color 0.3s;
}

/* TOP BAR */
.top-bar {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  padding: 8px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
}

.top-bar .controls {
  display: flex;
  gap: 16px;
  align-items: center;
}

.top-bar select, .top-bar button {
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-primary);
  padding: 4px 12px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.85rem;
}

.top-bar button:hover {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
}

/* HEADER */
header {
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  color: white;
  padding: 24px;
  box-shadow: 0 2px 8px var(--shadow);
}

.header-content {
  max-width: 1200px;
  margin: 0 auto;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.logo h1 {
  font-family: 'Merriweather', serif;
  font-size: 1.8rem;
  font-weight: 700;
}

.foundation-badge {
  background: rgba(255,255,255,0.2);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
}

.tagline {
  font-size: 0.95rem;
  opacity: 0.95;
}

/* NAV */
nav {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 4px var(--shadow);
}

nav ul {
  list-style: none;
  display: flex;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

nav li a {
  display: block;
  padding: 14px 20px;
  color: var(--text-primary);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
  border-bottom: 3px solid transparent;
}

nav li a:hover {
  color: var(--accent);
  background: var(--bg-primary);
  border-bottom-color: var(--accent);
}

/* MAIN */
main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 24px;
}

section {
  margin-bottom: 48px;
}

h2 {
  font-family: 'Merriweather', serif;
  font-size: 1.8rem;
  margin-bottom: 20px;
  color: var(--text-primary);
  border-bottom: 3px solid var(--accent);
  padding-bottom: 8px;
}

h3 {
  font-size: 1.3rem;
  margin-bottom: 12px;
  color: var(--text-primary);
}

/* CARDS */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px var(--shadow);
  transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 16px var(--shadow-lg);
}

.card h3 {
  color: var(--accent);
  margin-bottom: 10px;
}

.card p {
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.card a {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
}

.card a:hover {
  text-decoration: underline;
}

/* DISCLAIMER */
.disclaimer {
  background: var(--bg-secondary);
  border-left: 4px solid var(--warning);
  padding: 20px;
  margin-bottom: 32px;
  border-radius: 8px;
}

.disclaimer h3 {
  color: var(--warning);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.disclaimer p {
  color: var(--text-secondary);
  margin-bottom: 8px;
  font-size: 0.95rem;
}

.disclaimer strong {
  color: var(--text-primary);
}

/* FEED */
.feed-container {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
}

.feed-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
  display: flex;
  gap: 16px;
}

.feed-item img {
  width: 180px;
  height: 100px;
  object-fit: cover;
  border-radius: 6px;
  flex-shrink: 0;
}

.feed-item-content {
  flex: 1;
}

.feed-item h4 {
  color: var(--accent);
  margin-bottom: 6px;
  font-size: 1.1rem;
}

.feed-item .meta {
  color: var(--text-secondary);
  font-size: 0.85rem;
  margin-bottom: 8px;
}

.feed-item p {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.5;
}

.loading {
  text-align: center;
  padding: 40px;
  color: var(--text-secondary);
}

.spinner {
  border: 3px solid var(--border);
  border-top: 3px solid var(--accent);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* QUICK LINKS */
.quick-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.quick-link {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  text-align: center;
  text-decoration: none;
  color: var(--text-primary);
  font-weight: 500;
  transition: all 0.2s;
}

.quick-link:hover {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
  transform: translateY(-2px);
}

.quick-link i {
  font-size: 1.5rem;
  margin-bottom: 8px;
  display: block;
  color: var(--accent);
}

.quick-link:hover i {
  color: white;
}

/* FOOTER */
footer {
  background: var(--bg-secondary);
  border-top: 1px solid var(--border);
  padding: 40px 24px;
  margin-top: 60px;
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 32px;
}

.footer-section h3 {
  color: var(--accent);
  margin-bottom: 12px;
  font-size: 1.1rem;
}

.footer-section p, .footer-section a {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.8;
}

.footer-section a {
  text-decoration: none;
}

.footer-section a:hover {
  color: var(--accent);
}

.footer-bottom {
  max-width: 1200px;
  margin: 32px auto 0;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  text-align: center;
  color: var(--text-secondary);
  font-size: 0.85rem;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .top-bar {
    flex-direction: column;
    gap: 12px;
  }
  
  nav ul {
    flex-direction: column;
  }
  
  nav li a {
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
  }
  
  .feed-item {
    flex-direction: column;
  }
  
  .feed-item img {
    width: 100%;
    height: 200px;
  }
  
  .card-grid {
    grid-template-columns: 1fr;
  }
}

/* Font Awesome Icons */
.fa-icon::before {
  font-family: 'Font Awesome 6 Free';
  font-weight: 900;
}
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="top-bar">
  <div class="controls">
    <select id="lang-select" aria-label="Language">
      <option value="en">🇺🇸 English</option>
      <option value="es">🇪🇸 Español</option>
      <option value="fr">🇫🇷 Français</option>
    </select>
    <button id="theme-toggle" aria-label="Toggle theme">
      <span id="theme-icon">🌙</span> <span id="theme-text">Dark Mode</span>
    </button>
  </div>
  <div>
    <a href="https://foundation.moveweight.com" style="color: var(--accent); text-decoration: none; font-weight: 500;">
      A Project of the MoveWeight Foundation
    </a>
  </div>
</div>

<!-- HEADER -->
<header>
  <div class="header-content">
    <div class="logo">
      <h1 data-i18n="site-title">ExposeMiamiOK</h1>
      <span class="foundation-badge" data-i18n="nonprofit">Non-Profit Initiative</span>
    </div>
    <p class="tagline" data-i18n="tagline">Community Resources & Public Information Portal for Miami, Oklahoma</p>
  </div>
</header>

<!-- NAV -->
<nav>
  <ul>
    <li><a href="#resources" data-i18n="nav-resources">City Resources</a></li>
    <li><a href="#feed" data-i18n="nav-feed">Live Public Feed</a></li>
    <li><a href="#about" data-i18n="nav-about">About This Project</a></li>
    <li><a href="#transparency" data-i18n="nav-transparency">Transparency</a></li>
  </ul>
</nav>

<!-- MAIN -->
<main>

  <!-- DISCLAIMER -->
  <div class="disclaimer">
    <h3>⚠️ <span data-i18n="disclaimer-title">Important Notice</span></h3>
    <p data-i18n="disclaimer-1">
      <strong>ExposeMiamiOK.com is an independent community resource with no affiliation, partnership, or association with Guerrilla News, Ron Durbin, the City of Miami, Ottawa County, or any government entity, political candidate, or third-party organization.</strong>
    </p>
    <p data-i18n="disclaimer-2">
      This website aggregates publicly available information from open sources including YouTube RSS feeds, public government websites, court records, and news outlets. All content is presented for informational purposes only as a public service.
    </p>
    <p data-i18n="disclaimer-3">
      We do not create, produce, or endorse any of the third-party content displayed in our live feed. Views and opinions expressed in linked content belong solely to their original creators.
    </p>
  </div>

  <!-- CITY RESOURCES -->
  <section id="resources">
    <h2 data-i18n="resources-title">🏛️ Miami, Oklahoma — City Resources</h2>
    <p style="color: var(--text-secondary); margin-bottom: 20px;" data-i18n="resources-desc">
      Official city services, departments, and public information from miamiok.gov
    </p>
    
    <div class="quick-links">
      <a href="https://www.miamiok.gov/114/Government" class="quick-link">
        <i>🏛️</i>
        <span data-i18n="link-government">City Government</span>
      </a>
      <a href="https://www.miamiok.gov/210/Services" class="quick-link">
        <i>🛠️</i>
        <span data-i18n="link-services">City Services</span>
      </a>
      <a href="https://www.miamiok.gov/101/Community" class="quick-link">
        <i>👥</i>
        <span data-i18n="link-community">Community</span>
      </a>
      <a href="https://www.miamiok.gov/92/Ask-the-City" class="quick-link">
        <i>❓</i>
        <span data-i18n="link-ask">Ask the City</span>
      </a>
      <a href="https://www.miamiok.gov/DocumentCenter/View/3109/06022026-FY-2026-2027-Budget---Public-Hearing-Notice" class="quick-link">
        <i>💰</i>
        <span data-i18n="link-budget">Budget & Finance</span>
      </a>
      <a href="https://www.miamiok.gov/jobs.aspx" class="quick-link">
        <i>💼</i>
        <span data-i18n="link-jobs">City Jobs</span>
      </a>
    </div>

    <h3 style="margin-top: 32px; margin-bottom: 16px;" data-i18n="departments-title">City Departments</h3>
    <div class="card-grid">
      <div class="card">
        <h3>👮 Police Department</h3>
        <p data-i18n="dept-police">Public safety, law enforcement, and community policing programs.</p>
        <a href="https://www.miamiok.gov/Directory.aspx?DID=1" data-i18n="learn-more">Learn More →</a>
      </div>
      <div class="card">
        <h3>🔥 Fire Department</h3>
        <p data-i18n="dept-fire">Fire protection, emergency medical services, and fire prevention education.</p>
        <a href="https://www.miamiok.gov/Directory.aspx?DID=2" data-i18n="learn-more">Learn More →</a>
      </div>
      <div class="card">
        <h3>💧 Public Works</h3>
        <p data-i18n="dept-works">Water, sewer, streets, and infrastructure maintenance.</p>
        <a href="https://www.miamiok.gov/Directory.aspx?DID=3" data-i18n="learn-more">Learn More →</a>
      </div>
      <div class="card">
        <h3>📚 Library</h3>
        <p data-i18n="dept-library">Public library services, programs, and community resources.</p>
        <a href="https://www.miamiok.gov/Directory.aspx?DID=4" data-i18n="learn-more">Learn More →</a>
      </div>
      <div class="card">
        <h3>🏞️ Parks & Recreation</h3>
        <p data-i18n="dept-parks">Parks, recreational facilities, and community events.</p>
        <a href="https://www.miamiok.gov/Directory.aspx?DID=5" data-i18n="learn-more">Learn More →</a>
      </div>
      <div class="card">
        <h3>🏗️ Planning & Zoning</h3>
        <p data-i18n="dept-planning">Land use planning, zoning regulations, and development permits.</p>
        <a href="https://www.miamiok.gov/Directory.aspx?DID=6" data-i18n="learn-more">Learn More →</a>
      </div>
    </div>

    <h3 style="margin-top: 32px; margin-bottom: 16px;" data-i18n="officials-title">Elected Officials</h3>
    <div class="card-grid">
      <div class="card">
        <h3>🎖️ Mayor Bless Parker</h3>
        <p data-i18n="mayor-desc">Chief executive officer of the city, presides over council meetings.</p>
        <a href="https://www.miamiok.gov/Directory.aspx" data-i18n="contact-info">Contact Information →</a>
      </div>
      <div class="card">
        <h3>👥 City Council</h3>
        <p data-i18n="council-desc">Legislative body responsible for ordinances, budgets, and city policy.</p>
        <a href="https://www.miamiok.gov/Directory.aspx" data-i18n="council-members">Council Members →</a>
      </div>
    </div>
  </section>

  <!-- LIVE FEED -->
  <section id="feed">
    <h2 data-i18n="feed-title">📡 Live Public Information Feed</h2>
    <p style="color: var(--text-secondary); margin-bottom: 20px;" data-i18n="feed-desc">
      Real-time aggregation of publicly available content mentioning Miami, Oklahoma and related topics. Content is pulled directly from YouTube RSS feeds and filtered for relevant keywords.
    </p>

    <div class="feed-container">
      <div id="feed-content">
        <div class="loading">
          <div class="spinner"></div>
          <p data-i18n="loading">Loading public feed...</p>
        </div>
      </div>
    </div>

    <p style="margin-top: 16px; font-size: 0.85rem; color: var(--text-secondary);">
      <strong data-i18n="feed-source">Feed Source:</strong> <span data-i18n="feed-source-desc">YouTube RSS feed from public channel "Guerrilla News (Ron Durbin)" — filtered for Miami, Oklahoma-related content.</span> Last updated: <span id="feed-updated">—</span>
    </p>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <h2 data-i18n="about-title">ℹ️ About This Project</h2>
    <div class="card">
      <h3 data-i18n="about-what">What is ExposeMiamiOK?</h3>
      <p style="color: var(--text-secondary); margin-bottom: 16px;" data-i18n="about-desc">
        ExposeMiamiOK.com is a community information portal operated by the MoveWeight Foundation, a non-profit organization dedicated to civic engagement, government transparency, and public access to information.
      </p>
      <p style="color: var(--text-secondary); margin-bottom: 16px;" data-i18n="about-mission">
        Our mission is to provide Miami, Oklahoma residents with easy access to city resources, public records, and aggregated news coverage — all in one centralized location.
      </p>
      <a href="https://foundation.moveweight.com" style="color: var(--accent); font-weight: 500;" data-i18n="about-foundation">
        Learn more about the MoveWeight Foundation →
      </a>
    </div>

    <h3 style="margin-top: 32px; margin-bottom: 16px;" data-i18n="about-how">How It Works</h3>
    <div class="card-grid">
      <div class="card">
        <h3>🔍 Data Collection</h3>
        <p style="color: var(--text-secondary);" data-i18n="how-collect">
          We automatically aggregate public information from government websites, YouTube RSS feeds, court records, and news outlets using open-source tools.
        </p>
      </div>
      <div class="card">
        <h3>🎯 Smart Filtering</h3>
        <p style="color: var(--text-secondary);" data-i18n="how-filter">
          Content is filtered for relevance to Miami, Oklahoma using keyword matching and natural language processing to surface the most pertinent information.
        </p>
      </div>
      <div class="card">
        <h3>🌐 Open Access</h3>
        <p style="color: var(--text-secondary);" data-i18n="how-access">
          All information presented is publicly available. We simply organize and present it in an accessible format for community members.
        </p>
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY -->
  <section id="transparency">
    <h2 data-i18n="transparency-title">🔍 Transparency & Data Sources</h2>
    
    <div class="disclaimer" style="border-left-color: var(--success);">
      <h3 style="color: var(--success);">✅ <span data-i18n="transparency-sources">Our Data Sources</span></h3>
      <p data-i18n="transparency-list">
        <strong>All content on this site is sourced from:</strong><br>
        • Official City of Miami website (miamiok.gov)<br>
        • YouTube RSS feeds (public channel data)<br>
        • Ottawa County court records (public filings)<br>
        • Accredited news outlets (KOAM, KSNF/KODE, Read Frontier, Courthouse News)<br>
        • Federal court databases (10th Circuit Court of Appeals)<br>
        • Public government transparency portals
      </p>
    </div>

    <h3 style="margin-top: 32px; margin-bottom: 16px;" data-i18n="transparency-verify">Verify Our Sources</h3>
    <div class="card-grid">
      <div class="card">
        <h3>📋 City Records</h3>
        <p style="color: var(--text-secondary);" data-i18n="verify-city">
          All city information is directly sourced from the official Miami, Oklahoma government website and can be verified there.
        </p>
        <a href="https://www.miamiok.gov" data-i18n="visit-official">Visit Official Site →</a>
      </div>
      <div class="card">
        <h3>⚖️ Court Records</h3>
        <p style="color: var(--text-secondary);" data-i18n="verify-court">
          Legal case information is sourced from public court filings available through federal and state court databases.
        </p>
        <a href="https://www.justia.com" data-i18n="search-courts">Search Court Records →</a>
      </div>
      <div class="card">
        <h3>📰 News Coverage</h3>
        <p style="color: var(--text-secondary);" data-i18n="verify-news">
          News articles are linked directly to their original sources from accredited journalistic organizations.
        </p>
        <a href="https://www.koamnewsnow.com" data-i18n="view-sources">View News Sources →</a>
      </div>
    </div>
  </section>

</main>

<!-- FOOTER -->
<footer>
  <div class="footer-content">
    <div class="footer-section">
      <h3 data-i18n="footer-about">About ExposeMiamiOK</h3>
      <p data-i18n="footer-about-desc">
        A community information portal operated by the MoveWeight Foundation, a 501(c)(3) non-profit organization dedicated to civic engagement and government transparency.
      </p>
      <p style="margin-top: 12px;">
        <a href="https://foundation.moveweight.com" data-i18n="footer-foundation">MoveWeight Foundation →</a>
      </p>
    </div>
    
    <div class="footer-section">
      <h3 data-i18n="footer-contact">Contact</h3>
      <p data-i18n="footer-contact-desc">
        For questions, corrections, or information requests:<br>
        📧 info@exposemiamiok.com<br>
        🌐 foundation.moveweight.com
      </p>
    </div>
    
    <div class="footer-section">
      <h3 data-i18n="footer-legal">Legal</h3>
      <p data-i18n="footer-legal-desc">
        This website is not affiliated with any government entity, political candidate, or third-party organization. All content is presented for informational purposes only.
      </p>
    </div>
  </div>
  
  <div class="footer-bottom">
    <p data-i18n="footer-copyright">
      © 2026 MoveWeight Foundation. ExposeMiamiOK.com is a non-profit community service. All rights reserved.
    </p>
  </div>
</footer>

<script>
// Translations
const translations = {
  en: {
    'site-title': 'ExposeMiamiOK',
    'nonprofit': 'Non-Profit Initiative',
    'tagline': 'Community Resources & Public Information Portal for Miami, Oklahoma',
    'nav-resources': 'City Resources',
    'nav-feed': 'Live Public Feed',
    'nav-about': 'About This Project',
    'nav-transparency': 'Transparency',
    'disclaimer-title': 'Important Notice',
    'disclaimer-1': '<strong>ExposeMiamiOK.com is an independent community resource with no affiliation, partnership, or association with Guerrilla News, Ron Durbin, the City of Miami, Ottawa County, or any government entity, political candidate, or third-party organization.</strong>',
